{
  "name": "vni-ielts-ai",
  "private": true,
  "version": "0.0.0",
  "description": "VNI IELTS AI — learner web, admin CMS, and shared packages",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "infra": "docker compose -f infra/docker/compose.yaml up -d",
    "api": "dotnet run --project backend/src/Vni.Ielts.Api",
    "dev": "pnpm --filter @vni/web dev",
    "dev:admin": "pnpm --filter @vni/admin dev",
    "infra:stop": "docker compose -f infra/docker/compose.yaml down",
    "infra:reset": "docker compose -f infra/docker/compose.yaml down -v",
    "check": "pnpm docs:check && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:api",
    "test": "pnpm -r --if-present test",
    "test:api": "dotnet test backend --nologo",
    "typecheck": "pnpm -r --if-present typecheck",
    "docs:check": "python3 scripts/check-docs.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build && dotnet build backend --nologo"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

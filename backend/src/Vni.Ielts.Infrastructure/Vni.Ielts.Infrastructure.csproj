<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vni.Ielts.Application\Vni.Ielts.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SSO adapters are internal because nothing outside Infrastructure
         should bind to a provider's concrete type. The tests are the one
         exception: ID-token validation is the security-critical part of this
         layer and has to be exercised directly. -->
    <InternalsVisibleTo Include="Vni.Ielts.Infrastructure.Tests" />

    <!-- Integration tests need to seed an ExamVersion with a specific
         CreatedBy directly into Mongo — there is no create-exam endpoint yet
         (Phase 3), so a real HTTP path does not exist to set one up. Reusing
         ExamMappers.ToDocument() keeps the seeded shape identical to what the
         real write path produces, instead of a hand-built BSON document
         drifting from it. -->
    <InternalsVisibleTo Include="Vni.Ielts.Integration.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

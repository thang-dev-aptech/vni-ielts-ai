<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Vni.Ielts.Application\Vni.Ielts.Application.csproj" />
    <ProjectReference Include="..\Vni.Ielts.Infrastructure\Vni.Ielts.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Where the Google client secret lives during development.

         The id is a pointer, not a secret: the values sit outside the
         repository entirely, under ~/.microsoft/usersecrets/<id>/, and are
         loaded automatically only when the environment is Development. That
         is what makes it possible to run a real Google sign-in locally
         without a .env file, which .gitignore and a PreToolUse hook both
         block anyway. → CLAUDE.md rule 6, docs/development/sso-provider-setup.md -->
    <UserSecretsId>7ef8200d-2eb5-4a26-974f-b9ab754ba109</UserSecretsId>
  </PropertyGroup>

</Project>

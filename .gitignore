# ── Secrets — never commit ────────────────────────────────────────────
# CLAUDE.md rule 6: AI credentials never enter this repository.
# A PreToolUse hook blocks writes to .env*; this is the second line of defence.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Google hands you this file at the moment an OAuth client is created, and the
# browser drops it wherever downloads go — which on 2026-08-21 was the root of
# this repository, one `git add .` from being permanent. The real copy belongs
# outside the project entirely. → docs/development/sso-provider-setup.md
client_secret*.json
appsettings.*.local.json

# .mcp.json holds live API keys in plaintext (MCP server headers).
# Keep it local. If the team needs a shared template, commit .mcp.example.json
# with the key values blanked.
.mcp.json


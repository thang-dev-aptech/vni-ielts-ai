{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vni-ielts.ai/schemas/reading-listening-explanation.v1.json",
  "title": "Reading/Listening explanation (no band field)",
  "type": "object",
  "additionalProperties": false,
  "required": ["correctAnswer", "shortReason", "evidence"],
  "properties": {
    "correctAnswer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "shortReason": { "type": "string", "minLength": 1, "maxLength": 800 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1, "maxLength": 1000 },
          { "$ref": "#/$defs/evidenceReference" }
        ]
      }
    },
    "commonMistake": { "type": "string", "maxLength": 1000 }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "quote"],
      "properties": {
        "source": { "enum": ["passage", "transcript", "prompt"] },
        "quote": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

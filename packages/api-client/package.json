{
  "name": "@vni/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Types generated from contracts/openapi. Never hand-edited.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi/v1.json -o ./src/generated/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vni/config": "workspace:*",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2"
  }
}
